"use client";

import { useEffect, useMemo, useRef, useState } from "react";
import { createClient } from "@/lib/supabase/client";

type MessageItem = {
  id: string;
  booking_id: string;
  sender_id: string;
  content: string;
  is_read: boolean;
  delivered?: boolean | null;
  created_at: string;
};

type TypingRow = {
  booking_id: string;
  user_id: string;
  is_typing: boolean;
  updated_at: string;
};

function formatTime(value: string) {
  const d = new Date(value);
  if (Number.isNaN(d.getTime())) return "";
  return d.toLocaleTimeString([], {
    hour: "2-digit",
    minute: "2-digit",
  });
}

function getOwnMessageStatus(message: MessageItem) {
  if (message.is_read) return "Read";
  if (message.delivered) return "Delivered";
  return "Sent";
}

export default function ChatRoom({
  bookingId,
  currentUserId,
  otherUserName,
  initialMessages,
}: {
  bookingId: string;
  currentUserId: string;
  otherUserName: string;
  initialMessages: MessageItem[];
}) {
  const supabase = useMemo(() => createClient(), []);
  const bottomRef = useRef<HTMLDivElement | null>(null);
  const typingTimeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);

  const [messages, setMessages] = useState<MessageItem[]>(initialMessages || []);
  const [message, setMessage] = useState("");
  const [sending, setSending] = useState(false);
  const [otherTyping, setOtherTyping] = useState(false);
  const [errorMessage, setErrorMessage] = useState("");

  const sortedMessages = useMemo(() => {
    return [...messages].sort(
      (a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime()
    );
  }, [messages]);

  const scrollToBottom = () => {
    setTimeout(() => {
      bottomRef.current?.scrollIntoView({ behavior: "smooth" });
    }, 50);
  };

  const markDelivered = async () => {
    try {
      await fetch("/api/messages/delivered", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ bookingId }),
      });
    } catch (error) {
      console.error("mark delivered error:", error);
    }
  };

  const markAsRead = async () => {
    try {
      await fetch("/api/messages/mark-read", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ bookingId }),
      });
    } catch (error) {
      console.error("mark read error:", error);
    }
  };

  const setTypingState = async (isTyping: boolean) => {
    try {
      await fetch("/api/messages/typing", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          bookingId,
          isTyping,
        }),
      });
    } catch (error) {
      console.error("typing error:", error);
    }
  };

  const handleSend = async (e: React.FormEvent<HTMLFormElement>) => {
    e.preventDefault();

    const trimmed = message.trim();
    if (!trimmed) return;

    try {
      setSending(true);
      setErrorMessage("");

      const response = await fetch("/api/messages/send", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          bookingId,
          content: trimmed,
        }),
      });

      const raw = await response.text();
      let data: { error?: string; message?: MessageItem } = {};

      try {
        data = raw ? JSON.parse(raw) : {};
      } catch {
        data = { error: raw || "Could not send message" };
      }

      if (!response.ok) {
        setErrorMessage(data.error || "Could not send message");
        return;
      }

      if (data.message) {
        setMessages((prev) => {
          if (prev.some((m) => m.id === data.message!.id)) return prev;
          return [...prev, data.message!];
        });
      }

      setMessage("");
      await setTypingState(false);

      if (typingTimeoutRef.current) {
        clearTimeout(typingTimeoutRef.current);
      }

      scrollToBottom();
    } catch (error) {
      console.error("send message error:", error);
      setErrorMessage("Could not send message");
    } finally {
      setSending(false);
    }
  };

  useEffect(() => {
    scrollToBottom();
    void markDelivered();
    void markAsRead();
  }, [messages.length]);

  useEffect(() => {
    const messagesChannel = supabase
      .channel(`messages-room-${bookingId}`)
      .on(
        "postgres_changes",
        {
          event: "INSERT",
          schema: "public",
          table: "messages",
          filter: `booking_id=eq.${bookingId}`,
        },
        (payload) => {
          const newMessage = payload.new as MessageItem;
          setMessages((prev) => {
            if (prev.some((m) => m.id === newMessage.id)) return prev;
            return [...prev, newMessage];
          });
        }
      )
      .on(
        "postgres_changes",
        {
          event: "UPDATE",
          schema: "public",
          table: "booking_typing",
          filter: `booking_id=eq.${bookingId}`,
        },
        (payload) => {
          const row = payload.new as TypingRow;
          if (row.user_id !== currentUserId) {
            setOtherTyping(!!row.is_typing);
          }
        }
      )
      .subscribe();

    return () => {
      supabase.removeChannel(messagesChannel);
    };
  }, [bookingId, currentUserId, supabase]);

  return (
    <section className="rounded-[2rem] border border-slate-200 bg-white shadow-sm">
      <div className="border-b border-slate-200 px-6 py-5">
        <p className="text-sm font-medium text-slate-500">Conversation</p>
        <h2 className="mt-1 text-xl font-bold text-slate-900">{otherUserName}</h2>
      </div>

      <div className="space-y-4 px-6 py-6">
        {sortedMessages.length === 0 ? (
          <div className="rounded-2xl bg-slate-50 p-4 text-sm text-slate-600">
            No messages yet. Start the conversation below.
          </div>
        ) : (
          sortedMessages.map((item) => {
            const isOwn = item.sender_id === currentUserId;

            return (
              <div
                key={item.id}
                className={`flex ${isOwn ? "justify-end" : "justify-start"}`}
              >
                <div
                  className={`max-w-[80%] rounded-2xl px-4 py-3 text-sm shadow-sm ${
                    isOwn
                      ? "bg-indigo-600 text-white"
                      : "bg-slate-100 text-slate-900"
                  }`}
                >
                  <p className="whitespace-pre-wrap leading-6">{item.content}</p>
                  <div
                    className={`mt-2 flex items-center justify-end gap-2 text-[11px] ${
                      isOwn ? "text-indigo-100" : "text-slate-500"
                    }`}
                  >
                    <span>{formatTime(item.created_at)}</span>
                    {isOwn ? <span>{getOwnMessageStatus(item)}</span> : null}
                  </div>
                </div>
              </div>
            );
          })
        )}

        {otherTyping ? (
          <div className="text-xs text-slate-500">{otherUserName} is typing...</div>
        ) : null}

        <div ref={bottomRef} />
      </div>

      <form onSubmit={handleSend} className="border-t border-slate-200 px-6 py-5">
        {errorMessage ? (
          <div className="mb-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            {errorMessage}
          </div>
        ) : null}

        <div className="flex gap-3">
          <textarea
            value={message}
            onChange={(e) => {
              const value = e.target.value;
              setMessage(value);

              if (value.trim()) {
                void setTypingState(true);

                if (typingTimeoutRef.current) {
                  clearTimeout(typingTimeoutRef.current);
                }

                typingTimeoutRef.current = setTimeout(() => {
                  void setTypingState(false);
                }, 1500);
              } else {
                void setTypingState(false);

                if (typingTimeoutRef.current) {
                  clearTimeout(typingTimeoutRef.current);
                }
              }
            }}
            placeholder="Write your message..."
            className="min-h-[56px] flex-1 resize-none rounded-2xl border border-slate-300 px-4 py-3 outline-none transition focus:border-indigo-500"
          />

          <button
            type="submit"
            disabled={sending || !message.trim()}
            className="rounded-2xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700 disabled:cursor-not-allowed disabled:opacity-60"
          >
            {sending ? "Sending..." : "Send"}
          </button>
        </div>
      </form>
    </section>
  );
}